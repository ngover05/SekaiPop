#%PAM-1.0
# Only used when Quickshell comes from Nix on a distro that isn't NixOS (install-deps-debian.sh).
# Nix's libpam loads modules from its own store folder, so the distro's /etc/pam.d/login can name
# ones it doesn't have (Mint's encrypted home adds "auth required pam_ecryptfs.so"), and then every
# password fails with a PAM error. This asks only the question the lockscreen needs: is this the
# user's password. pam_unix checks it through /run/wrappers/bin/unix_chkpwd, the distro's setuid copy.
auth required pam_unix.so
